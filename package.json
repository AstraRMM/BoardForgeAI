{
  "name": "boardforge-ai",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "lint": "eslint .",
    "start": "next start",
    "test:plugin": "node --test ./plugins/boardforge-plugin/tests/*.test.mjs",
    "test:golden": "node ./plugins/boardforge-plugin/bin/boardforge-plugin.mjs --job ./plugins/boardforge-plugin/examples/verified-demo-job.json --workspace ./plugins/boardforge-plugin/tmp",
    "test:fixtures": "node ./plugins/boardforge-plugin/bin/boardforge-regression.mjs --workspace ./plugins/boardforge-plugin/tmp/regression",
    "test:regression": "node ./plugins/boardforge-plugin/bin/boardforge-regression.mjs --workspace ./plugins/boardforge-plugin/tmp/regression",
    "test:exports": "node ./plugins/boardforge-plugin/bin/boardforge-regression.mjs --workspace ./plugins/boardforge-plugin/tmp/regression",
    "test:kicad": "node ./plugins/boardforge-plugin/bin/boardforge-plugin.mjs --job ./plugins/boardforge-plugin/examples/verified-demo-job.json --workspace ./plugins/boardforge-plugin/tmp",
    "test:jlcpcb-package": "node ./plugins/boardforge-plugin/bin/boardforge-plugin.mjs --job-json \"{\\\"id\\\":\\\"validate_package\\\",\\\"type\\\":\\\"validate_manufacturing_package\\\",\\\"input\\\":{\\\"projectPath\\\":\\\"boardforge-verified-demo-usb-sensor\\\"}}\" --workspace ./plugins/boardforge-plugin/tmp",
    "test:readiness-score": "node ./plugins/boardforge-plugin/bin/boardforge-regression.mjs --workspace ./plugins/boardforge-plugin/tmp/regression",
    "test:resolver": "node --test --test-name-pattern \"library|resolver|component|3d|footprint\" ./plugins/boardforge-plugin/tests/*.test.mjs",
    "test:placement": "node --test --test-name-pattern \"placement\" ./plugins/boardforge-plugin/tests/*.test.mjs",
    "test:routing": "node --test --test-name-pattern \"routing|autoroute|trace\" ./plugins/boardforge-plugin/tests/*.test.mjs",
    "test:routing-endpoints": "node --test --test-name-pattern \"endpoint-aware|endpoint reroute|same-net unsafe\" ./plugins/boardforge-plugin/tests/*.test.mjs",
    "test:drc-repair": "node --test --test-name-pattern \"DRC repair|drc repair|repair planner|self repair|same-net unsafe\" ./plugins/boardforge-plugin/tests/*.test.mjs",
    "test:blocked-fixtures": "node ./plugins/boardforge-plugin/bin/boardforge-regression.mjs --workspace ./plugins/boardforge-plugin/tmp/regression --target 90",
    "test:robotics": "node ./plugins/boardforge-plugin/bin/boardforge-regression.mjs --workspace ./plugins/boardforge-plugin/tmp/regression --target 90",
    "test:industrial-io": "node ./plugins/boardforge-plugin/bin/boardforge-regression.mjs --workspace ./plugins/boardforge-plugin/tmp/regression --target 90",
    "test:poe": "node ./plugins/boardforge-plugin/bin/boardforge-regression.mjs --workspace ./plugins/boardforge-plugin/tmp/regression --target 90",
    "test:existing-project": "node ./plugins/boardforge-plugin/bin/boardforge-regression.mjs --workspace ./plugins/boardforge-plugin/tmp/regression --target 90",
    "test:arbitrary-prompts": "node ./plugins/boardforge-plugin/bin/boardforge-regression.mjs --workspace ./plugins/boardforge-plugin/tmp/regression --target 90",
    "report:90": "node ./plugins/boardforge-plugin/bin/boardforge-regression.mjs --workspace ./plugins/boardforge-plugin/tmp/regression --target 90",
    "report:90:quick": "node ./plugins/boardforge-plugin/bin/boardforge-regression.mjs --workspace ./plugins/boardforge-plugin/tmp/regression --target 90 --quick",
    "boardforge": "node ./plugins/boardforge-plugin/bin/boardforge-cli.mjs",
    "boardforge:init": "node ./plugins/boardforge-plugin/bin/boardforge-cli.mjs init",
    "boardforge:create": "node ./plugins/boardforge-plugin/bin/boardforge-cli.mjs create",
    "boardforge:validate": "node ./plugins/boardforge-plugin/bin/boardforge-cli.mjs validate",
    "boardforge:route": "node ./plugins/boardforge-plugin/bin/boardforge-cli.mjs route",
    "boardforge:cleanup": "node ./plugins/boardforge-plugin/bin/boardforge-cli.mjs cleanup",
    "boardforge:export": "node ./plugins/boardforge-plugin/bin/boardforge-cli.mjs export",
    "boardforge:report": "node ./plugins/boardforge-plugin/bin/boardforge-cli.mjs report",
    "boardforge:replay": "node ./plugins/boardforge-plugin/bin/boardforge-cli.mjs replay",
    "boardforge:dashboard-data": "node ./plugins/boardforge-plugin/bin/boardforge-dashboard-data.mjs",
    "smoke:plugin": "node ./plugins/boardforge-plugin/bin/boardforge-plugin.mjs --job ./plugins/boardforge-plugin/examples/outline-job.json --workspace ./plugins/boardforge-plugin/tmp",
    "mcp:plugin": "node ./plugins/boardforge-plugin/bin/boardforge-mcp.mjs --workspace ./boardforge-workspace",
    "sync:libraries": "node ./plugins/boardforge-plugin/bin/boardforge-plugin.mjs --job ./plugins/boardforge-plugin/examples/library-sync-job.json --workspace ./boardforge-workspace",
    "resolve:components": "node ./plugins/boardforge-plugin/bin/boardforge-plugin.mjs --job ./plugins/boardforge-plugin/examples/resolve-components-job.json --workspace ./boardforge-workspace",
    "test:platform-productization": "node --test --test-name-pattern \"product manifest|AI command runner|AI command layer|AI session report|routeability scoring|promotion candidate|KiCad plugin scaffold|canonical BoardForge CLI\" ./plugins/boardforge-plugin/tests/*.test.mjs",
    "test:routeability-promotion-gate": "node --test --test-name-pattern \"routeability scoring|promotion candidate\" ./plugins/boardforge-plugin/tests/*.test.mjs",
    "test:product-platform-manifest": "node --test --test-name-pattern \"local engine exposes|required workflow|project manifest|dashboard sample manifest|manifest-driven dashboard data|AI session report|engine candidate selector|odd-shape robot fixture|fixture runner creates|report 90 quick mode\" ./plugins/boardforge-plugin/tests/*.test.mjs",
    "test:solution-library": "node --test ./plugins/boardforge-plugin/tests/solution-library.test.mjs",
    "test:web-dashboard-project-data": "node --test --test-name-pattern \"dashboard sample manifest|project manifest\" ./plugins/boardforge-plugin/tests/*.test.mjs",
    "test:kicad-plugin-action-log": "node --test --test-name-pattern \"KiCad plugin scaffold\" ./plugins/boardforge-plugin/tests/*.test.mjs",
    "test:cli-replay-command": "node --test --test-name-pattern \"dashboard sample manifest\" ./plugins/boardforge-plugin/tests/*.test.mjs",
    "fixtures:list": "node ./plugins/boardforge-plugin/bin/boardforge-fixture-runner.mjs --list",
    "fixtures:run": "node ./plugins/boardforge-plugin/bin/boardforge-fixture-runner.mjs --run",
    "fixtures:golden": "node ./plugins/boardforge-plugin/bin/boardforge-fixture-runner.mjs --golden",
    "fixtures:report": "node ./plugins/boardforge-plugin/bin/boardforge-fixture-runner.mjs --report"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.40.0",
    "jszip": "^3.10.1",
    "lucide-react": "^1.17.0",
    "next": "^16.2.9",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "three": "^0.184.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.6.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2"
  }
}
